# PostgreSQL local (crie o banco antes de executar a migração)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/assistente_precificacao

# Usadas somente pelo docker-compose.yml. Defina uma senha forte e use o mesmo valor em DATABASE_URL.
POSTGRES_DB=assistente_precificacao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-local-segura

# Use uma sequência aleatória com pelo menos 32 caracteres. Nunca versione o .env.
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa-com-32-caracteres

# Porta usada somente por pnpm start/pnpm dev no desenvolvimento local.
PORT=3000
NODE_ENV=development

# Em produção, use HTTPS e mantenha este valor como true.
SESSION_COOKIE_SECURE=false

# Focus NFe: mantenha homologação durante desenvolvimento e testes.
# Em NODE_ENV=production, a aplicação usa produção por padrão. A URL abaixo força homologação local.
# Configure o token correspondente ao ambiente somente fora do Git; nunca neste arquivo.
FOCUS_NFE_TOKEN=token-ficticio-configure-no-ambiente
FOCUS_NFE_BASE_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_TIMEOUT_MS=5000

# Use postgres para pesquisar o catálogo próprio sem chamadas externas.
# Em produção, MARKET_DATABASE_URL deve apontar para um banco dedicado, diferente de DATABASE_URL.
# Em desenvolvimento/teste, o modo postgres pode usar DATABASE_URL se MARKET_DATABASE_URL estiver vazia.
MARKET_PROVIDER=dataforseo
MARKET_DATABASE_URL=

# DataForSEO: consultas pagas por uso, somente no backend quando MARKET_PROVIDER=dataforseo.
# Use o login e a senha da área API Access; nunca envie credenciais ao navegador.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_TIMEOUT_MS=15000
DATAFORSEO_TASK_TIMEOUT_MS=120000

# Assistente de preenchimento: chave exclusivamente no backend, nunca no Git.
# Sem chave, o preenchimento manual e as fórmulas continuam disponíveis.
# /health informa modelo/contrato efetivos e códigos de configuração, nunca o segredo.
# Em um terminal local configurado, pnpm gemini:check faz uma geração real e consome quota.
# O .env local não configura a Vercel: cadastre segredos em Project Settings > Environment Variables.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_FILL_MODE=complete
AI_TIMEOUT_MS=25000
